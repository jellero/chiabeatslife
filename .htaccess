Options -Indexes -MultiViews

RewriteEngine On
RewriteBase /

<FilesMatch "^(?:\.env(?:\.example)?|composer\.(?:json|lock)|phpunit\.xml|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Codice applicativo e snapshot sorgente non sono esposti direttamente.
RewriteRule ^(?:bootstrap|config|resources|src|storage|tests|tools|vendor)(?:/|$) - [F,L,NC]

# Supporta hosting con document-root puntato alla root del repository.
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
RewriteRule ^(.+)$ public/$1 [L]

# Unico front controller Slim 4.
RewriteRule ^ public/index.php [QSA,L]
